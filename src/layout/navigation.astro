---
import config from '../../config';
const path = Astro.url.pathname;
---
<header class="site-header shell">
    <a class="brand" href="/" aria-label={`${config.site_title} 홈`}><span class="monogram" aria-hidden="true">m.</span>{config.site_title}</a>
    <nav aria-label="주 메뉴">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>기록</a>
        <a href="/tags" aria-current={path.startsWith('/tags') ? 'page' : undefined}>태그</a>
        <a href="https://portfolio.malangnuo.com/" rel="noopener noreferrer">About ↗</a>
    </nav>
</header>
